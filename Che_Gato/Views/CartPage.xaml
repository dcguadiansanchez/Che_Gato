<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Che_Gato.Views.CartPage"
             BackgroundColor="#FFF9F2"
             Title="Carrito">

    <ContentPage.Resources>
        <Color x:Key="CatOrange">#FF7B00</Color>
        <Color x:Key="CatDark">#2C3E50</Color>
        <Color x:Key="CatGray">#8395A7</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">
        
        <Label Grid.Row="0" Text="Tu Orden 🛒" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource CatDark}" Margin="0,0,0,15"/>

        <!-- Aquí conectamos la lista real del carrito -->
        <CollectionView x:Name="CartCollectionView" Grid.Row="1" ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="White" Padding="15" Margin="0,0,0,15">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.05" Offset="0,5" Radius="10" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="80, *, Auto" ColumnSpacing="15">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="#F8F9FA" HeightRequest="80">
                                <Image Source="{Binding Producto.ImageUrl}" Aspect="AspectFill" Margin="10"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5">
                                <Label Text="{Binding Producto.Nombre}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource CatDark}"/>
                                <Label Text="{Binding Subtotal, StringFormat='${0:F2}'}" TextColor="{StaticResource CatOrange}" FontAttributes="Bold"/>
                                <Label Text="{Binding Quantity, StringFormat='Cantidad: {0}'}" TextColor="{StaticResource CatGray}" FontSize="12"/>
                            </VerticalStackLayout>
                            <!-- Botón para eliminar -->
                            <Label Grid.Column="2" Text="❌" FontSize="16" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRemoveItemTapped" CommandParameter="{Binding .}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Resumen de Compra -->
        <Border Grid.Row="2" StrokeShape="RoundRectangle 25" StrokeThickness="0" BackgroundColor="White" Padding="20" Margin="0,15,0,0">
            <Border.Shadow><Shadow Brush="Black" Opacity="0.08" Offset="0,-5" Radius="15" /></Border.Shadow>
            <VerticalStackLayout Spacing="15">
                
                <HorizontalStackLayout Spacing="10">
                    <Label Text="📍" FontSize="20" VerticalOptions="Center"/>
                    <VerticalStackLayout>
                        <Label Text="Entregar en:" FontSize="12" TextColor="{StaticResource CatGray}"/>
                        <Label Text="Guanajuato, Centro" FontAttributes="Bold" TextColor="{StaticResource CatDark}" FontSize="14"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                
                <BoxView HeightRequest="1" Color="#F0F0F0" />

                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="5">
                    <Label Grid.Row="0" Grid.Column="0" Text="Subtotal" TextColor="{StaticResource CatGray}" />
                    <Label x:Name="SubtotalLabel" Grid.Row="0" Grid.Column="1" Text="$0.00" TextColor="{StaticResource CatDark}" FontAttributes="Bold"/>
                    
                    <Label Grid.Row="1" Grid.Column="0" Text="Tarifa de envío" TextColor="{StaticResource CatGray}" />
                    <Label x:Name="EnvioLabel" Grid.Row="1" Grid.Column="1" Text="$0.00" TextColor="{StaticResource CatDark}" FontAttributes="Bold"/>
                </Grid>
                
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="Total a Pagar" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource CatDark}" />
                    <Label x:Name="TotalLabel" Grid.Column="1" Text="$0.00" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource CatOrange}" />
                </Grid>

                <Button Text="Proceder al Pago" TextColor="White" FontAttributes="Bold" FontSize="16" HeightRequest="55" CornerRadius="27" Margin="0,10,0,0" Clicked="OnCheckoutClicked">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF7B00" Offset="0.0" />
                            <GradientStop Color="#FF3300" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>