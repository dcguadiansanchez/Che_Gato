<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Che_Gato.Views.CheckoutPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Checkout"
             BackgroundColor="{StaticResource CatCream}">

    <ScrollView>
        <VerticalStackLayout Padding="20,50,20,30" Spacing="24">

            <Label Text="Resumen de tu pedido" Style="{StaticResource ScreenTitle}" />

            <Border Style="{StaticResource SoftCard}">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout HorizontalOptions="FillAndExpand">
                        <Label Text="Artículos en el carrito" Style="{StaticResource Subtitle}" HorizontalOptions="StartAndExpand" />
                        <Label x:Name="ItemCountLabel" Text="0" Style="{StaticResource Subtitle}" TextColor="{StaticResource CatCharcoal}" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource CatMist}" />
                    <HorizontalStackLayout>
                        <Label Text="Total a pagar" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource CatCharcoal}" HorizontalOptions="StartAndExpand" />
                        <Label x:Name="TotalLabel" Style="{StaticResource PriceLabel}" FontSize="20" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="10">
                <Label Text="Método de pago" Style="{StaticResource SectionLabel}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                    <Border Grid.Column="0"
                            x:Name="CardTarjeta"
                            Style="{StaticResource PaymentOption}">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4" Padding="0,10">
                            <Label Text="💳" FontSize="26" HorizontalOptions="Center" />
                            <Label Text="Tarjeta" HorizontalOptions="Center" FontAttributes="Bold" TextColor="{StaticResource CatCharcoal}" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSelectCard" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Column="1"
                            x:Name="CardEfectivo"
                            Style="{StaticResource PaymentOption}">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4" Padding="0,10">
                            <Label Text="💵" FontSize="26" HorizontalOptions="Center" />
                            <Label Text="Efectivo" HorizontalOptions="Center" FontAttributes="Bold" TextColor="{StaticResource CatCharcoal}" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSelectCash" />
                        </Border.GestureRecognizers>
                    </Border>

                </Grid>
            </VerticalStackLayout>

            <Button Text="Confirmar Pedido"
                    Style="{StaticResource PrimaryButton}"
                    HeightRequest="58"
                    Clicked="OnConfirmClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
