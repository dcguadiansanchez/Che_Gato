<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Che_Gato.Views.RegisterPage"
             BackgroundColor="#FFF9F2">

    <ContentPage.Resources>
        <Color x:Key="CatDark">#2C3E50</Color>
        <Color x:Key="CatGray">#8395A7</Color>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="30,50,30,30" Spacing="20" VerticalOptions="Center" x:Name="MainForm">

            <!-- Título y Encabezado -->
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="😺 📝" FontSize="45" HorizontalOptions="Center" Margin="0,0,0,5"/>
                <Label Text="Únete a la manada" FontSize="30" FontAttributes="Bold" TextColor="#FF5E00" HorizontalOptions="Center" />
                <Label Text="Regístrate para pedir tus antojos" FontSize="15" TextColor="{StaticResource CatGray}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Tarjeta Principal de Registro -->
            <Border StrokeShape="RoundRectangle 30" StrokeThickness="0" BackgroundColor="White" Padding="25,30" Margin="0,10,0,0">
                <Border.Shadow>
                    <Shadow Brush="#FF7B00" Opacity="0.15" Offset="0,15" Radius="25" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">
                    
                    <!-- Input Nombre -->
                    <Border StrokeShape="RoundRectangle 16" Stroke="#F0F0F0" StrokeThickness="2" BackgroundColor="#FAFAFA" Padding="15,5">
                        <Entry x:Name="NameEntry" Placeholder="Tu nombre (Ej. Michi Pérez)" TextColor="{StaticResource CatDark}" BackgroundColor="Transparent" HeightRequest="50"/>
                    </Border>

                    <!-- Input Correo -->
                    <Border StrokeShape="RoundRectangle 16" Stroke="#F0F0F0" StrokeThickness="2" BackgroundColor="#FAFAFA" Padding="15,5">
                        <Entry x:Name="RegEmailEntry" Placeholder="Correo electrónico" Keyboard="Email" TextColor="{StaticResource CatDark}" BackgroundColor="Transparent" HeightRequest="50"/>
                    </Border>

                    <!-- Input Contraseña -->
                    <Border StrokeShape="RoundRectangle 16" Stroke="#F0F0F0" StrokeThickness="2" BackgroundColor="#FAFAFA" Padding="15,5">
                        <Entry x:Name="RegPasswordEntry" Placeholder="Contraseña" IsPassword="True" TextColor="{StaticResource CatDark}" BackgroundColor="Transparent" HeightRequest="50"/>
                    </Border>

                    <!-- Botón con Degradado -->
                    <Button Text="🐾 Crear mi cuenta" 
                            Clicked="OnRegisterClicked"
                            TextColor="White" 
                            FontAttributes="Bold" 
                            FontSize="18"
                            HeightRequest="60" 
                            CornerRadius="30" 
                            Margin="0,10,0,0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF7B00" Offset="0.0" />
                                <GradientStop Color="#FF3300" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Shadow>
                            <Shadow Brush="#FF3300" Opacity="0.4" Offset="0,8" Radius="15"/>
                        </Button.Shadow>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <!-- Ir a Login -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,15,0,0">
                <Label Text="¿Ya tienes tu cuenta?" TextColor="{StaticResource CatGray}" VerticalOptions="Center"/>
                <Label Text="Inicia sesión" TextColor="#FF5E00" FontAttributes="Bold" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackToLoginTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>