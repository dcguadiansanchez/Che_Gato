<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Che_Gato.Views.LoginPage"
             BackgroundColor="#FFF9F2">

    <ContentPage.Resources>
        <Color x:Key="CatDark">#2C3E50</Color>
        <Color x:Key="CatGray">#8395A7</Color>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="30,60,30,30" Spacing="25" VerticalOptions="Center" x:Name="MainForm">

            <!-- Íconos Flotantes y Título -->
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center" Margin="0,0,0,10">
                    <Label Text="🍕" FontSize="40" Rotation="-15" />
                    <Label Text="🐱" FontSize="55" />
                    <Label Text="🍔" FontSize="40" Rotation="15" />
                </HorizontalStackLayout>
                
                <Label Text="Che Gato" FontSize="34" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#FF5E00" />
                
                <Label Text="Delivery de antojos feroces" FontSize="16" TextColor="{StaticResource CatGray}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Tarjeta Principal de Login -->
            <Border StrokeShape="RoundRectangle 30" StrokeThickness="0" BackgroundColor="White" Padding="25,35" Margin="0,10,0,0">
                <Border.Shadow>
                    <Shadow Brush="#FF7B00" Opacity="0.15" Offset="0,15" Radius="25" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="22">
                    
                    <Border StrokeShape="RoundRectangle 16" Stroke="#F0F0F0" StrokeThickness="2" BackgroundColor="#FAFAFA" Padding="15,5">
                        <Entry x:Name="EmailEntry" Placeholder="Correo electrónico" Keyboard="Email" TextColor="{StaticResource CatDark}" BackgroundColor="Transparent" HeightRequest="50"/>
                    </Border>

                    <Border StrokeShape="RoundRectangle 16" Stroke="#F0F0F0" StrokeThickness="2" BackgroundColor="#FAFAFA" Padding="15,5">
                        <Entry x:Name="PasswordEntry" Placeholder="Contraseña" IsPassword="True" TextColor="{StaticResource CatDark}" BackgroundColor="Transparent" HeightRequest="50"/>
                    </Border>

                    <!-- Botón con Degradado Espectacular -->
                    <Button Text="Entrar a comer" 
                            Clicked="OnLoginClicked"
                            TextColor="White" 
                            FontAttributes="Bold" 
                            FontSize="18"
                            HeightRequest="60" 
                            CornerRadius="30" 
                            Margin="0,15,0,0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF7B00" Offset="0.0" />
                                <GradientStop Color="#FF3300" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Shadow>
                            <Shadow Brush="#FF3300" Opacity="0.4" Offset="0,8" Radius="15"/>
                        </Button.Shadow>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,15,0,0">
                <Label Text="¿Aún no eres parte de la manada?" TextColor="{StaticResource CatGray}" VerticalOptions="Center"/>
                <Label Text="Regístrate" TextColor="#FF5E00" FontAttributes="Bold" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoToRegisterTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>